{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // ---- LEITURA E INSPEÇÃO: liberadas (não destroem nada) ----
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },

    // ---- ESCRITA EM ARQUIVO: sempre pede autorização ----
    // Cobre edit, write e patch em qualquer caminho do projeto.
    { "action": "edit", "resource": "*", "effect": "ask" },

    // ---- SHELL: pergunta por padrão... ----
    { "action": "shell", "resource": "*", "effect": "ask" },

    // ...mas libera inspeção git (somente leitura) para não travar o fluxo.
    // Padrão terminado em " *" também casa o comando sem argumentos.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },

    // ---- COMMITS E PUSH: explícito, sempre pergunta ----
    // Obs.: na hora do prompt use "Allow once". O "Allow always" grava uma
    // regra de allow durável e esses comandos deixariam de perguntar.
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ]
}
